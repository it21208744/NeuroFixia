# Copy to .env and adjust
PORT=5000
# MongoDB Atlas / local connection string. Leave empty to use an embedded in-memory MongoDB (demo mode; data is lost on restart)
MONGO_URI=
JWT_SECRET=change-me-to-a-long-random-string
# URL of the Python ML service (ml-service/app.py)
ML_URL=http://127.0.0.1:5001
# Optional: comma separated list of allowed browser origins (default: allow all)
CORS_ORIGINS=
